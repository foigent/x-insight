[Unit]
Description=X-Insight LiteLLM spend-log pull worker
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/x-insight/current
ConditionPathIsReadWrite=/var/lib/x-insight

[Service]
Type=simple
User=xinsight
Group=xinsight
WorkingDirectory=/opt/x-insight/current
EnvironmentFile=/etc/x-insight/xinsight-litellm-feed.env
LoadCredential=postgres-importer.dsn:/etc/x-insight/database/current/postgres-importer.dsn
LoadCredential=litellm-feed.key:/etc/x-insight/litellm-feed.key
ExecStart=/opt/x-insight/current/bin/xinsight-importer litellm pull-spend-logs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=60s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.0.0.0/8
IPAddressAllow=100.64.0.0/10
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.0.0/16
IPAddressAllow=fc00::/7

[Install]
WantedBy=multi-user.target
