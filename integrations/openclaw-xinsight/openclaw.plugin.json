{
  "id": "xi-work-events",
  "name": "X-Insight Work Events",
  "description": "Bounded metadata observations and durable delivery to X-Insight",
  "categories": ["other"],
  "providers": ["xi-ur-observed"],
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["origin", "outboxPath"],
    "properties": {
      "origin": { "type": "string" },
      "outboxPath": { "type": "string" },
      "bodyOutboxPath": { "type": "string" },
      "tokenFile": { "type": "string" },
      "installationId": { "type": "string", "pattern": "^xiei_[a-f0-9]{32}$" },
      "selectedAgentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$" },
      "bodyKeyFile": { "type": "string" },
      "syntheticLoopback": { "type": "boolean" },
      "managedProvider": {
        "type": "object", "additionalProperties": false, "required": ["baseUrl"],
        "properties": {"baseUrl": {"type": "string"}, "excludedProviderIds": {"type": "array", "maxItems": 100, "items": {"type": "string"}}}
      },
      "provider": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "baseUrl": { "type": "string" },
          "models": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": { "type": "object", "required": ["id", "name", "reasoning", "input", "cost", "contextWindow", "maxTokens"],
              "properties": {
                "id": { "type": "string" }, "name": { "type": "string" },
                "reasoning": { "type": "boolean" },
                "input": { "type": "array", "minItems": 1, "items": { "enum": ["text", "image"] } },
                "cost": { "type": "object", "required": ["input", "output", "cacheRead", "cacheWrite"],
                  "properties": { "input": { "type": "number" }, "output": { "type": "number" },
                    "cacheRead": { "type": "number" }, "cacheWrite": { "type": "number" } } },
                "contextWindow": { "type": "integer" }, "maxTokens": { "type": "integer" }
              } }
          }
        }
      }
    }
  }
}
