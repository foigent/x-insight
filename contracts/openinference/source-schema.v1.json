{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xinsight://sources/openinference/otlp-span/v1",
  "title": "X-Insight sanitized OpenInference LLM span V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "span_id",
    "span_name",
    "span_kind",
    "start_time",
    "end_time",
    "status",
    "model",
    "missing_parent"
  ],
  "properties": {
    "schema_version": { "const": "xinsight.otlp-openinference-span.v1" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "parent_span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "span_name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "span_kind": { "const": "LLM" },
    "start_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "end_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "status": { "enum": ["succeeded", "failed"] },
    "model": { "type": "string", "minLength": 1, "maxLength": 240 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
    "prompt_tokens": { "$ref": "#/$defs/nonnegativeInt64" },
    "completion_tokens": { "$ref": "#/$defs/nonnegativeInt64" },
    "total_tokens": { "$ref": "#/$defs/nonnegativeInt64" },
    "actor_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "service_name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "missing_parent": { "type": "boolean" }
  },
  "$defs": {
    "nonnegativeInt64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    }
  }
}
