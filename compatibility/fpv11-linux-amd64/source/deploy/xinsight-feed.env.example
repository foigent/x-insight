# Non-secret worker configuration. The service key is supplied only through
# the unirouter-feed.key systemd credential.
XINSIGHT_UNIROUTER_FEED_ENDPOINT=https://REPLACE_WITH_PRIVATE_UNIROUTER_HOST/api/v1/integrations/xinsight/completed-executions
XINSIGHT_UNIROUTER_FEED_POLL_INTERVAL=5s
# Keep false for HTTPS. Set true only when deployment evidence proves this
# fixed endpoint is carried by an authenticated private tunnel.
XINSIGHT_UNIROUTER_FEED_ALLOW_PRIVATE_TUNNEL_HTTP=false
# legacy is the compatibility default; shadow and neutral_canary require the
# Phase 2C promotion gates.
XINSIGHT_UNIROUTER_FEED_MAPPING_MODE=legacy
