{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x-insight.local/schemas/integration/feed-credential-registration-v1.schema.json",
  "title": "UniRouter X-Insight Feed Credential Registration V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token_format",
    "verifier_scheme",
    "key_prefix",
    "verifier_sha256",
    "operation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "unirouter.xinsight.feed-credential-registration.v1"
    },
    "token_format": {
      "const": "ur-xf1-hex256.v1"
    },
    "verifier_scheme": {
      "const": "receiver_sha256_v1"
    },
    "key_prefix": {
      "type": "string",
      "pattern": "^ur-xf1-[0-9a-f]{13}$"
    },
    "verifier_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
