{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x-insight.local/schemas/access/local-accounts-v1.schema.json",
  "title": "X-Insight Local Accounts V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "accounts"
  ],
  "properties": {
    "schema_version": {
      "const": "xinsight.local-accounts.v1"
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "username",
          "role",
          "disabled",
          "password_hash"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^xs_[a-z0-9]{16,64}$"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "role": {
            "enum": [
              "investigator",
              "operator"
            ]
          },
          "disabled": {
            "type": "boolean"
          },
          "password_hash": {
            "type": "string",
            "pattern": "^\\$argon2id\\$v=19\\$m=19456,t=2,p=1\\$[A-Za-z0-9+/]{22}\\$[A-Za-z0-9+/]{43}$"
          }
        }
      }
    }
  }
}
