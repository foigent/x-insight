{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Usage Field Group",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prompt_tokens": { "type": "integer", "minimum": 0 },
    "completion_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "cost_cents": { "type": "integer", "minimum": 0 },
    "cost_micros": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" },
    "currency": { "const": "CNY" },
    "amount_scale": { "const": 1000000 },
    "money_schema": { "const": "micro-cny.v1" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "ttft_ms": { "type": "integer", "minimum": 0 },
    "usage_source": { "type": "string" },
    "usage_confidence": { "type": "string" },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "oneOf": [
    {
      "not": {
        "anyOf": [
          { "required": ["cost_cents"] },
          { "required": ["cost_micros"] },
          { "required": ["currency"] },
          { "required": ["amount_scale"] },
          { "required": ["money_schema"] }
        ]
      }
    },
    {
      "required": ["cost_cents"],
      "not": {
        "anyOf": [
          { "required": ["cost_micros"] },
          { "required": ["currency"] },
          { "required": ["amount_scale"] },
          { "required": ["money_schema"] }
        ]
      }
    },
    {
      "required": ["cost_micros", "currency", "amount_scale", "money_schema"],
      "not": { "required": ["cost_cents"] }
    }
  ]
}
