{
  "name": "x-insight-frontend",
  "version": "0.0.0-prd2-p2-0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "prebuild": "node scripts/require-toolchain.mjs",
    "build": "tsc -b && vite build && node scripts/write-asset-manifest.mjs && node scripts/validate-dist.mjs",
    "precheck": "node scripts/require-toolchain.mjs",
    "check": "tsc -b --pretty false",
    "pretest": "node scripts/require-toolchain.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/require-toolchain.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "serve:e2e": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "install:e2e:chromium": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "check:openapi": "node scripts/validate-openapi.mjs",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.11"
  }
}
