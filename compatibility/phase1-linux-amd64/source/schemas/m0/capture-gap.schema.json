{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X-Insight M0 Capture Gap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_system_id",
    "adapter_manifest_id",
    "gap_type",
    "affected_claim",
    "gap_reason",
    "severity",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string" },
    "source_system_id": { "type": "string" },
    "adapter_manifest_id": { "type": "string" },
    "request_id": { "type": "string" },
    "gap_type": { "type": "string" },
    "affected_claim": { "type": "string" },
    "gap_reason": { "type": "string" },
    "severity": { "enum": ["info", "warning", "error"] },
    "created_at": { "type": "string" }
  }
}
