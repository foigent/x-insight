server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name REPLACE_WITH_PUBLIC_IP;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/x-insight/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name REPLACE_WITH_PUBLIC_IP;

    ssl_certificate /etc/letsencrypt/live/REPLACE_WITH_PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_PUBLIC_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 8k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
