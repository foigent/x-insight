[Unit]
Description=X-Insight managed Source Facts worker
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/x-insight/current
ConditionPathIsReadWrite=/var/lib/x-insight
ConditionPathExists=/etc/x-insight/source-facts.json

[Service]
Environment=XINSIGHT_SOURCE_MANAGED_PARTITIONS=xinsight.managed-source-partitions.v1
Type=simple
User=xinsight
Group=xinsight
RuntimeDirectory=x-insight-review-source
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/x-insight/current
EnvironmentFile=-/etc/x-insight/xinsight-review-body.env
LoadCredential=postgres-importer.dsn:/etc/x-insight/database/current/postgres-importer.dsn
ExecStartPre=+/usr/bin/env -i /opt/x-insight/current/bin/xinsightctl review-body-config validate
ExecStart=/opt/x-insight/current/bin/xinsight-importer unirouter run-source-facts
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=60s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.0.0.0/8
IPAddressAllow=100.64.0.0/10
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.0.0/16
IPAddressAllow=fc00::/7

[Install]
WantedBy=multi-user.target
