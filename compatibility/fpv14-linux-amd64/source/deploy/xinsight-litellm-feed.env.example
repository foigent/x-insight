# Non-secret LiteLLM Connector configuration. The API key is supplied only
# through the isolated litellm-feed.key systemd credential.
XINSIGHT_LITELLM_FEED_ENDPOINT=https://REPLACE_WITH_PRIVATE_LITELLM_HOST/spend/logs/v2
XINSIGHT_LITELLM_FEED_POLL_INTERVAL=30s
XINSIGHT_LITELLM_FEED_SOURCE_INSTANCE=REPLACE_WITH_STABLE_LITELLM_INSTANCE
# Leave tenant blank when the source scope has no tenant layer.
XINSIGHT_LITELLM_FEED_TENANT_REF=
XINSIGHT_LITELLM_FEED_ORG_REF=REPLACE_WITH_CANONICAL_ORG_REF
XINSIGHT_LITELLM_FEED_PROJECT_REF=REPLACE_WITH_CANONICAL_PROJECT_REF
