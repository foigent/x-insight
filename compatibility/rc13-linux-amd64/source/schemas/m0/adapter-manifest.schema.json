{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X-Insight M0 Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "adapter_version",
    "source_type",
    "fidelity_level",
    "ingestion_modes",
    "direct_field_groups",
    "derived_field_groups",
    "known_capture_gaps",
    "payload_behavior",
    "idempotency_strategy",
    "declared_event_types"
  ],
  "properties": {
    "adapter_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "supported_source_versions": { "type": "array", "items": { "type": "string" } },
    "fidelity_level": { "enum": ["F0", "F1", "F2", "F3"] },
    "ingestion_modes": { "type": "array", "items": { "type": "string" } },
    "direct_field_groups": { "type": "array", "items": { "type": "string" } },
    "derived_field_groups": { "type": "array", "items": { "type": "string" } },
    "known_capture_gaps": { "type": "array", "items": { "type": "string" } },
    "payload_behavior": { "type": "string" },
    "idempotency_strategy": { "type": "string" },
    "cursor_strategy": { "type": "string" },
    "declared_event_types": { "type": "array", "items": { "type": "string" } }
  }
}
